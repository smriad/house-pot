# Open-weight model (Gemma via Ollama, vLLM, or OpenAI-compatible gateway)
GEMMA_BASE_URL=http://127.0.0.1:11434/v1
GEMMA_API_KEY=ollama
GEMMA_MODEL=gemma3:4b

# --- Cloud Gemma (Render / Vercel — no Ollama on the host) ---
# Google AI Studio (Render — Gemma 3): https://aistudio.google.com/apikey
# GEMMA_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# GEMMA_API_KEY=your_google_ai_studio_key
# GEMMA_MODEL=gemma-4-4b-it
#
# Groq (gemma2-9b-it retired): use openai/gpt-oss-20b or switch to AI Studio above
# GEMMA_BASE_URL=https://api.groq.com/openai/v1
# GEMMA_API_KEY=gsk_...
# GEMMA_MODEL=openai/gpt-oss-20b
# MongoDB Atlas (household memory). Falls back to local JSON if unset.
MONGODB_URI=

# ElevenLabs (recipe read-aloud only — not for pantry voice memos)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# SerpApi (optional substitute finder)
SERPAPI_API_KEY=

# Backboard (cross-thread cook memory — Best Use of Backboard)
BACKBOARD_API_KEY=
BACKBOARD_ASSISTANT_ID=

# Sentry agent tracing (optional — Best Use of Sentry)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# Local Whisper (pip install -r requirements.txt)
WHISPER_MODEL=base
# Optional: venv python with openai-whisper installed
WHISPER_PYTHON=

# ElevenLabs Scribe (pantry STT fallback when Whisper is unavailable)
ELEVENLABS_STT_MODEL=scribe_v2

# Ollama embeddings for pantry memory (nomic-embed-text)
EMBED_MODEL=nomic-embed-text

# MongoDB Atlas Vector Search index name (optional)
MONGODB_VECTOR_INDEX=pantry_memories_vector

# Temporal durable narration (docker compose -f docker-compose.temporal.yml up -d)
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
# Set TEMPORAL_NARRATE=false to force in-process narration

# Tiger Data / Postgres (feedback mirror — optional)
TIGER_DATABASE_URL=

# TabPFN (optional: pip install -r requirements-tabpfn.txt)
TABPFN_PYTHON=

# Public app URL for Render
NEXT_PUBLIC_APP_URL=http://localhost:3000
